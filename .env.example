# Obtenha sua chave em: https://console.x.ai/
XAI_API_KEY=sua_chave_aqui

# Opcional — valores padrão já funcionam
XAI_BASE_URL=https://api.x.ai/v1
GROK_MODEL=grok-3-mini
MAX_TOKENS=1024

# Vídeo de fundo (URL direta do .mp4)
BACKGROUND_VIDEO_URL=https://exemplo.com/seu-video.mp4
BACKGROUND_POSTER_URL=

# HotTrack — geração/consulta de PIX e tracking de leads
# Token encontrado na aba "API & docs" do painel da HotTrack
HOTTRACK_BASE_URL=https://hot-track.com
HOTTRACK_API_KEY=
